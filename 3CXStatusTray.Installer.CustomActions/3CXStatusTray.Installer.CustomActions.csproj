<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Managed Custom Action for WiX v6. Targets net472 because the WiX
      DTF custom-action host loads under the legacy .NET Framework loader
      hosted by the MSI engine. Using a newer target framework here is
      possible but requires distributing extra runtime files; net472
      is already present on every supported Windows install (7 SP1+).
    -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>WriteAppSettings</RootNamespace>
    <AssemblyName>WriteAppSettings.CA</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- WiX DTF packages the output with MakeSfxCA at build time. -->
    <GenerateCASfx>true</GenerateCASfx>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WixToolset.Dtf.CustomAction is the ONLY NuGet dep on purpose. Anything
      else we pull in here (e.g. System.Text.Json) has transitive deps
      (System.Memory, System.Buffers, ...) that MakeSfxCA has to bundle into
      the self-extracting CA container, and that part is fragile - missing
      a dep manifests at install time as MSI error 1723 'A DLL required for
      this install to complete could not be run'. Keeping this project
      framework-only means there is nothing extra to bundle.
    -->
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CustomAction.config tells the SfxCA loader which .NET runtime to host.
      MakeSfxCA bundles this file if it's next to the output DLL at packing
      time, so copy it to output.
    -->
    <Content Include="CustomAction.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Version>1.0.0</Version>
    <OutputName>3CXStatusTray-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE61 fires for AllowSameVersionUpgrades; suppress, documented as safe. -->
    <SuppressIces>ICE61</SuppressIces>

    <!--
      WiX v6 no longer auto-creates $(var.ProjectName.TargetDir) /
      TargetPath preprocessor variables from <ProjectReference>. Define
      them manually here; referenced as $(var.Name) inside .wxs files.
    -->
    <TrayBuildDir>$(MSBuildThisFileDirectory)..\3CXStatusTray\bin\$(Configuration)\net8.0-windows\</TrayBuildDir>
    <CustomActionDll>$(MSBuildThisFileDirectory)..\3CXStatusTray.Installer.CustomActions\bin\$(Configuration)\net472\WriteAppSettings.CA.dll</CustomActionDll>
    <DefineConstants>Version=$(Version);TrayBuildDir=$(TrayBuildDir);CustomActionDll=$(CustomActionDll)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.NetFx.wixext" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both project references are required to build the MSI:
        - 3CXStatusTray supplies the tray payload (exe + deps + icons).
          Windows-only (net8.0-windows, WinForms), so the MSI is
          effectively Windows-build-only.
        - 3CXStatusTray.Installer.CustomActions supplies the managed
          Custom Action DLL used to write appsettings.json at install time.
    -->
    <ProjectReference Include="..\3CXStatusTray\3CXStatusTray.csproj">
      <Properties>Configuration=$(Configuration);Platform=AnyCPU</Properties>
    </ProjectReference>
    <ProjectReference Include="..\3CXStatusTray.Installer.CustomActions\3CXStatusTray.Installer.CustomActions.csproj">
      <Properties>Configuration=$(Configuration);Platform=AnyCPU</Properties>
    </ProjectReference>
  </ItemGroup>

</Project>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <!--
    3CX Status Tray MSI. Decisions captured in docs/installer-design.md.

    UpgradeCode must NEVER change across versions - it's how MSI identifies
    "the same product" for upgrade purposes. Generated 2026-04-20. If you
    regenerate this by accident, existing installs will become un-upgradeable.
  -->
  <Package Name="3CX Status Tray"
           Manufacturer="Wharfs"
           Version="$(var.Version)"
           UpgradeCode="79eabc17-d2d6-46a5-8fa4-2ba2ae1f8a71"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="3CX Status Tray installer"
                        Manufacturer="Wharfs" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of 3CX Status Tray is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      If a 3CXStatusTray.exe is running when the installer starts (upgrade
      scenario), politely close it before file operations. Without this,
      Windows Installer's Restart Manager notices the EXE is in use, asks
      the user about it, proceeds ambivalently, and sometimes leaves the
      install in a half-applied state with a stale process still around.
      TerminateProcess=3 = send WM_CLOSE, wait up to 3 seconds for graceful
      shutdown, force-kill after that if still running.
    -->
    <util:CloseApplication
        Id="CloseExistingTray"
        Target="3CXStatusTray.exe"
        CloseMessage="yes"
        ElevatedCloseMessage="yes"
        RebootPrompt="no"
        TerminateProcess="3" />

    <!--
      .NET 8 Desktop Runtime check. netfx:DotNetCompatibilityCheck sets
      a property to the negotiated framework version when the runtime is
      present; the Launch condition gates the install on it.
    -->
    <netfx:DotNetCompatibilityCheck Property="DOTNETDESKTOP8"
                                    RuntimeType="desktop"
                                    Platform="x64"
                                    Version="8.0.0" />
    <Launch Condition="Installed OR DOTNETDESKTOP8"
            Message="This application requires the .NET 8 Desktop Runtime (x64). Install it from https://dotnet.microsoft.com/download/dotnet/8.0 and run this installer again." />

    <!--
      Upgrade memory: read previously-stored values back into MSI properties
      before the UI runs. Effect: interactive upgrade pre-populates the
      dialog with the previous install's settings; silent upgrade with no
      properties reuses the previous values; silent upgrade with explicit
      properties overrides.
    -->
    <Property Id="SERVER_URL" Value="http://localhost:8889/">
      <RegistrySearch Id="RegSearchServerUrl"
                      Root="HKLM"
                      Key="Software\3CXStatusTray\Config"
                      Name="ServerUrl"
                      Type="raw" />
    </Property>
    <Property Id="API_KEY" Secure="yes">
      <RegistrySearch Id="RegSearchApiKey"
                      Root="HKLM"
                      Key="Software\3CXStatusTray\Config"
                      Name="ApiKey"
                      Type="raw" />
    </Property>
    <Property Id="EXTENSION_ID" Value="100">
      <RegistrySearch Id="RegSearchExtensionId"
                      Root="HKLM"
                      Key="Software\3CXStatusTray\Config"
                      Name="ExtensionId"
                      Type="raw" />
    </Property>
    <Property Id="POLL_INTERVAL_MS" Value="5000">
      <RegistrySearch Id="RegSearchPollInterval"
                      Root="HKLM"
                      Key="Software\3CXStatusTray\Config"
                      Name="PollIntervalMs"
                      Type="raw" />
    </Property>

    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="3CXStatusTray" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="3CX Status Tray" />
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />

    <Icon Id="AppIcon.ico" SourceFile="..\3CXStatusTray\icons\app-default.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Wharfs/3CXStatusTray" />

    <!-- Features -->
    <Feature Id="Main" Title="3CX Status Tray" Level="1" Display="expand">
      <ComponentGroupRef Id="TrayPayload" />
      <ComponentRef Id="ConfigureScript" />
      <ComponentRef Id="UpgradeMemoryRegistry" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>

    <!--
      Harvest the tray's build output via <Files>. The tray's csproj
      sets CopyToOutputDirectory on appsettings.json and the icons, so
      they sit alongside the exe and .NET dependency DLLs in the build
      output folder. Exclude appsettings.json and *.pdb - the Custom
      Action writes a fresh appsettings.json, and .pdb files are
      debug symbols we don't want shipping to end-user machines.
    -->
    <ComponentGroup Id="TrayPayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.TrayBuildDir)**\*">
        <Exclude Files="$(var.TrayBuildDir)appsettings.json" />
        <Exclude Files="$(var.TrayBuildDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!--
      The PowerShell script that writes appsettings.json + upgrade-memory
      registry values at install time. Bundled in the MSI and placed into
      INSTALLFOLDER so the deferred CA can invoke it by absolute path.
    -->
    <Component Id="ConfigureScript" Directory="INSTALLFOLDER"
               Guid="0cbdb7e2-1e44-4a17-b1e3-3c9b65c6c3d1">
      <File Id="ConfigureAppSettingsPs1"
            Source="ConfigureAppSettings.ps1"
            KeyPath="yes" />
    </Component>

    <!--
      Registry component for the upgrade-memory subtree. Needs an explicit
      component (not just the custom action's runtime writes) so uninstall
      can clean up properly.
    -->
    <Component Id="UpgradeMemoryRegistry" Directory="INSTALLFOLDER"
               Guid="19875e9c-7959-4109-a5f0-316ae93993e0">
      <RegistryKey Root="HKLM" Key="Software\3CXStatusTray\Config" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="InstallMarker" Value="1" Type="integer" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <!--
      Start Menu shortcut. KeyPath HAS to be HKCU per ICE38/ICE43 even
      though the shortcut is placed in the all-users Start Menu. Windows
      Installer treats shortcut directories as "per-user" for component-
      tracking purposes, irrespective of where the shortcut actually
      lands on disk.
    -->
    <Component Id="StartMenuShortcut" Directory="AppShortcutFolder"
               Guid="9f1b2eb9-9b4c-4298-98ce-fe8a0770107d">
      <Shortcut Id="StartMenuShortcutLnk"
                Name="3CX Status Tray"
                Description="Phone status tray applet"
                Target="[INSTALLFOLDER]3CXStatusTray.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\3CXStatusTray"
                     Name="StartMenuShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- All-users Startup folder shortcut (autostart). Same HKCU KeyPath quirk. -->
    <Component Id="StartupShortcut" Directory="StartupFolder"
               Guid="cc563e3a-e968-43fc-84ad-1a6fd496f1e7">
      <Shortcut Id="StartupShortcutLnk"
                Name="3CX Status Tray"
                Target="[INSTALLFOLDER]3CXStatusTray.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\3CXStatusTray"
                     Name="StartupShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!--
      Configure appsettings.json via a PowerShell deferred Custom Action.

      Two-step pattern required by MSI for deferred CAs:
        1. SetProperty (immediate mode) builds the full command line from
           MSI properties and stuffs it into a property that happens to
           share a name with the deferred CA.
        2. The deferred CA itself (BinaryRef=Wix4UtilCA_X64, DllEntry=
           WixQuietExec64) pulls that command line out of CustomActionData
           at deferred-execute time, then shells out to PowerShell.

      WixQuietExec64 is the 64-bit silent-exec helper in Util.wixext:
      runs the command to completion, pipes stdout/stderr to the MSI
      log, honours the Return="check" setting so non-zero exit codes
      fail the install.
    -->
    <!--
      SetProperty Id MUST match the deferred CA Id ('WriteAppSettings').
      That's how MSI wires the value through: for a deferred CA, its
      Session.CustomActionData is auto-populated from the property whose
      name matches the action name. Using any other property name (e.g.
      WixQuietExec64CmdLine) means the CA can't find its input and
      fails with 0x80070057 "Failed to get command line data".
    -->
    <SetProperty Id="WriteAppSettings"
                 Value='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "[#ConfigureAppSettingsPs1]" -ServerUrl "[SERVER_URL]" -ApiKey "[API_KEY]" -ExtensionId "[EXTENSION_ID]" -PollIntervalMs [POLL_INTERVAL_MS]'
                 Before="WriteAppSettings"
                 Sequence="execute"
                 Condition="NOT REMOVE" />

    <CustomAction Id="WriteAppSettings"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="WriteAppSettings" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- UI: built-in WixUI_InstallDir extended with our ConfigDialog (see Dialogs/ConfigDialog.wxs) -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <UIRef Id="ConfigDialogUI" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!--
      Launch-on-finish. Adds a 'Launch 3CX Status Tray' checkbox to the
      ExitDialog, pre-ticked, that runs the exe impersonated as the user
      who invoked the installer. Skipped entirely for silent installs
      (no UI = no checkbox = no DoAction trigger), which is a feature:
      silent installs are typically scripted en masse and you don't want
      a tray icon to appear on the admin's own desktop for every client.
    -->
    <!--
      Directly shell-exec the installed tray as the user who ran the
      installer. Simpler than WixShellExec (no util extension dependency,
      no WixShellExecTarget property routing). Return=asyncNoWait means
      the installer doesn't block on the tray's message loop; the CA
      fires the launch and returns immediately.
    -->
    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand='"[INSTALLFOLDER]3CXStatusTray.exe"'
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch 3CX Status Tray" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Order="999"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
